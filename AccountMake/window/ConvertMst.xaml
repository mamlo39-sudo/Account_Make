<Window x:Class="AccountMake.ConvertMst"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountMake"
        mc:Ignorable="d"
        x:Name="winMstMain"
        Title="変換テーブル" Height="650" Width="910" ResizeMode="NoResize" Loaded="Window_Loaded">
    <Grid>
        <Grid x:Name="LayoutRoot" Background="#FF2B6F7A">

            <TextBlock Text="変換テーブル" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="10,10,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="30" Width="140" FontSize="20" FontWeight="Heavy"/>

            <DataGrid x:Name="grdDBdata" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="11,40,0,0" Height="344" Width="874"
                      IsReadOnly="True"/>

            <Grid x:Name="grdMstOpe" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,400,0,0" Height="135" Width="874">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="White" BorderThickness="2" Grid.Row="1" Grid.RowSpan="8" Grid.ColumnSpan="6"/>

                <TextBlock Text="検索条件" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="20" Width="100" FontSize="15" FontWeight="Heavy"  Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>

                <TextBlock Text="人事所属" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="1"/>

                <TextBox x:Name="txtSyozoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="2" Grid.Column="2" />

                <TextBlock Text="人事係講座" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="4" Grid.Column="1"/>

                <TextBox x:Name="txtKakari" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="4" Grid.Column="2"/>

                <TextBlock Text="人事職種" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="6" Grid.Column="1"/>

                <TextBox x:Name="txtSyoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="6" Grid.Column="2"/>

                <Button x:Name="btnSerch" Content="検索" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" 
                        Height="95" Width="90" Grid.Row="2" Grid.RowSpan="5" Grid.Column="4" Click="btnSerch_Click"/>

                <Border BorderBrush="White" BorderThickness="2" Grid.Row="1" Grid.Column="7" Grid.RowSpan="8" Grid.ColumnSpan="9"/>

                <TextBlock Text="データ挿入" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="20" Width="100" FontSize="15" FontWeight="Heavy"  Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="3"/>

                <Label x:Name="lblUpdata" Content="※参照IDを入力後，全項目空で更新すると該当IDのデータは削除されます。" Grid.Row="0" Grid.Column="10" Grid.ColumnSpan="6" VerticalAlignment="Top" HorizontalAlignment="Left"  Margin="0,-3,0,0" FontSize="11" FontWeight="Medium"  Foreground="Salmon"/>

                <TextBlock x:Name="lblID" Text="参照ID" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="70" FontSize="15" Grid.Row="2" Grid.Column="8"/>

                <TextBox x:Name="txtSansho" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="70" FontSize="13" Grid.Row="3" Grid.RowSpan="2" Grid.Column="8" LostFocus="txtSansho_LostFocus"/>

                <TextBlock Text="人事所属" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="10"/>

                <TextBox x:Name="txtInSyozoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="2" Grid.Column="11" IsReadOnly="True"/>

                <TextBlock Text="人事係講座" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="4" Grid.Column="10"/>

                <TextBox x:Name="txtInKakari" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="4" Grid.Column="11" IsReadOnly="True"/>

                <TextBlock Text="人事職種" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="6" Grid.Column="10"/>

                <TextBox x:Name="txtInSyoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="6" Grid.Column="11" IsReadOnly="True"/>

                <TextBlock Text="全学所属" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="13"/>

                <TextBox x:Name="txtInZenSyozoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="2" Grid.Column="14" IsReadOnly="True" />

                <TextBlock Text="全学学科" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="4" Grid.Column="13"/>

                <TextBox x:Name="txtInZenKakari" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="4" Grid.Column="14" IsReadOnly="True"/>

                <TextBlock Text="全学職種" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="6" Grid.Column="13"/>

                <TextBox x:Name="txtInZenSyoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="100" FontSize="13" Grid.Row="6" Grid.Column="14" IsReadOnly="True"/>

                <Button x:Name="btnInsert" Content="挿入" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,0,0" 
                        Height="35" Width="70" Grid.Row="5" Grid.RowSpan="2" Grid.Column="8" Click="btnInsert_Click"/>

            </Grid>

            <Grid x:Name="grdRecode" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,540,0,0" Height="65" Width="874">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="White" BorderThickness="2" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="10"/>

                <TextBlock Text="変換不可情報" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="20" Width="100" FontSize="15" FontWeight="Heavy" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"/>

                <TextBlock Text="人事所属" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="1"/>

                <TextBox x:Name="txtRSyozoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="2" Grid.Column="2" IsReadOnly="True"/>

                <TextBlock Text="人事係講座" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="4"/>

                <TextBox x:Name="txtRKakari" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="2" Grid.Column="5" IsReadOnly="True"/>

                <TextBlock Text="人事職種" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Center" Margin="0,0,0,0" 
					   Foreground="AliceBlue" Background="#FF5CC7C7" Height="25" Width="80" FontSize="15" Grid.Row="2" Grid.Column="7"/>

                <TextBox x:Name="txtRSyoku" Text="" VerticalAlignment="Top" HorizontalAlignment="Left"  TextAlignment="Left" Margin="0,0,0,0" 
					     Height="25" Width="190" FontSize="13" Grid.Row="2" Grid.Column="8" IsReadOnly="True"/>

            </Grid>

        </Grid>
    </Grid>
</Window>
